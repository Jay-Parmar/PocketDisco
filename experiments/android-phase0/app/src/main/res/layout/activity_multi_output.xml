<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android multi-output probe"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Generated click audio only. A selected route is a request until Android reports the active destination." />

        <TextView
            android:id="@+id/output_capability_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Checking outputs" />

        <Button
            android:id="@+id/refresh_outputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh outputs" />

        <Button
            android:id="@+id/open_output_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open system output switcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="First direct output"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/first_output"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Second direct output"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/second_output"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <CheckBox
            android:id="@+id/safe_volume_confirmed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Both outputs are at a safe volume" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LAN coordinator generated signal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/multi_output_scenario_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shared scenario ID, for example mixed-01"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/multi_output_client_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stable client ID, for example android-phone"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Client environment"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/multi_output_environment"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observed output category"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/multi_output_category"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/multi_output_coordinator_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordinator URL, for example http://192.168.1.2:8765"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/multi_output_coordinator_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordinator bearer token"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/sync_multi_output_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take 7 coordinator time samples" />

        <TextView
            android:id="@+id/multi_output_clock_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clock: sample required" />

        <EditText
            android:id="@+id/multi_output_coordinator_trial_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordinator trial UUID"
            android:importantForAutofill="no"
            android:inputType="text" />

        <RadioGroup
            android:id="@+id/coordinator_output_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/coordinator_system_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Schedule current system route" />

            <RadioButton
                android:id="@+id/coordinator_dual_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Schedule selected dual tracks" />
        </RadioGroup>

        <Button
            android:id="@+id/create_generated_trial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create and schedule trial 25 seconds ahead" />

        <Button
            android:id="@+id/fetch_generated_trial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fetch and schedule generated trial" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Local output probe"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/run_system_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Run current system route" />

        <Button
            android:id="@+id/run_dual_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run selected dual tracks" />

        <Button
            android:id="@+id/stop_multi_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop" />

        <Button
            android:id="@+id/export_multi_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export output telemetry" />

        <Button
            android:id="@+id/export_generated_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export coordinated telemetry v2" />

        <TextView
            android:id="@+id/multi_output_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="24dp"
            android:text="Idle"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
