[Unit]
Description=PocketDisco isolated PostgreSQL cluster
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=pocketdisco-db
Group=pocketdisco-db
RuntimeDirectory=pocketdisco-postgres
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/postgresql/16/bin/postgres -D /var/lib/pocketdisco/postgres -c config_file=/etc/pocketdisco/postgres.conf
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=60
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pocketdisco/postgres /run/pocketdisco-postgres
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
MemoryDenyWriteExecute=true
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
